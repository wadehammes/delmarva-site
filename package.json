{
  "name": "delmarva-site",
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5656",
    "email:dev": "email dev --dir src/components/Email --port 3030 --clients gmail,outlook,apple-mail,yahoo",
    "email:export": "email export --dir src/components/Email --outDir out/emails",
    "email:resend:setup": "email resend setup",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev -p 5656",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start -p 5656",
    "tsc:ci": "tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:check": "biome check --changed --since origin/staging --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:all": "pnpm lint:check && pnpm lint:css:fix && pnpm tsc:ci && pnpm knip:ci",
    "test:ci": "jest --passWithNoTests --runInBand",
    "types:contentful": "export $(cat .env.local | sed '/^#/d; s/[$\"]//g'); cf-content-types-generator -s $CONTENTFUL_SPACE_ID -t $CONTENTFUL_CMA_TOKEN -o src/contentful/types -r -g && biome format --write src/contentful/types",
    "update-readme": "node scripts/update_main_readme.js",
    "knip": "knip",
    "knip:ci": "knip --no-progress"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@contentful/rich-text-plain-text-renderer": "^17.2.1",
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@hookform/resolvers": "^5.9.1",
    "@next/third-parties": "^16.4.0",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "contentful": "^11.12.10",
    "gsap": "^3.15.0",
    "jotai": "^3.0.1",
    "mapbox-gl": "^3.32.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.89.0",
    "react-intersection-observer": "^11.0.1",
    "resend": "^6.32.0",
    "safe-json-stringify": "^1.2.0",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1",
    "swiper": "^14.3.0",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@jest/types": "^30.5.1",
    "@mapbox/point-geometry": "^1.1.0",
    "@react-email/ui": "6.11.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/safe-json-stringify": "^1.1.5",
    "cf-content-types-generator": "^3.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-mock": "^30.5.2",
    "knip": "^6.39.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.5.5",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "ts-jest": "^29.4.14",
    "typescript": "^7.0.2",
    "typescript-plugin-css-modules": "^5.2.0"
  }
}
