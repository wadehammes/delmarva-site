{
  "name": "delmarva-site",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5656 --webpack",
    "email:dev": "email dev --dir src/components/Email --port 3030 --clients gmail,outlook,apple-mail,yahoo",
    "email:export": "email export --dir src/components/Email --outDir out/emails",
    "email:resend:setup": "email resend setup",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev -p 5656 --webpack",
    "build": "next build --webpack",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start -p 5656",
    "export": "next export",
    "tsc:ci": "tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:check": "biome check --changed --since origin/main --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:all": "pnpm lint:check && pnpm lint:css:fix",
    "test:ci": "jest --passWithNoTests --runInBand",
    "types:contentful": "export $(cat .env.local | sed '/^#/d; s/[$\"]//g'); cf-content-types-generator -s $CONTENTFUL_SPACE_ID -t $CONTENTFUL_CMA_TOKEN -o src/contentful/types -r -g && biome format --write src/contentful/types",
    "update-readme": "node scripts/update_main_readme.js",
    "knip": "knip",
    "knip:ci": "knip --no-progress"
  },
  "dependencies": {
    "@contentful/rich-text-plain-text-renderer": "^17.2.1",
    "@contentful/rich-text-react-renderer": "^16.2.1",
    "@contentful/rich-text-types": "^17.2.7",
    "@next/third-parties": "^16.2.6",
    "@tanstack/react-query": "^5.100.13",
    "clsx": "^2.1.1",
    "contentful": "^11.12.2",
    "gsap": "^3.15.0",
    "jotai": "^2.20.0",
    "mapbox-gl": "^3.24.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "react": "^19.2.6",
    "react-aria": "^3.48.0",
    "react-dom": "^19.2.6",
    "react-email": "^6.5.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.76.0",
    "react-intersection-observer": "^10.0.3",
    "resend": "^6.12.3",
    "safe-json-stringify": "^1.2.0",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swiper": "^12.1.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@jest/types": "^30.4.1",
    "@react-email/ui": "6.5.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/safe-json-stringify": "^1.1.5",
    "cf-content-types-generator": "^3.0.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock": "^30.4.1",
    "knip": "^6.14.2",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.0",
    "stylelint": "^17.12.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "webpack": "^5.107.1",
    "@mapbox/point-geometry": "^1.1.0",
    "identity-obj-proxy": "^3.0.0"
  }
}
